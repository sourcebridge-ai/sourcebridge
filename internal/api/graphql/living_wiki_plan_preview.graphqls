# CA-146: Plan preview query + types.
#
# This file maps to living_wiki_plan_preview.resolvers.go under gqlgen's
# follow-schema layout. Keeping the query field and its exclusive types here
# prevents a "method already declared" conflict when gqlgen regenerates
# schema.resolvers.go from schema.graphqls.
#
# LivingWikiBuildMode is intentionally kept in schema.graphqls because it is
# also used by the retryLivingWikiJob mutation defined there.

extend type Query {
  # CA-146: preview the page plan a Living Wiki build would produce.
  previewLivingWikiPlan(repositoryId: ID!, mode: LivingWikiBuildMode, pageCountOverride: Int): LivingWikiPlan!
}

# ─────────────────────────────────────────────────────────────────────────────
# CA-146: Plan preview types
# ─────────────────────────────────────────────────────────────────────────────

"""
LivingWikiPageType classifies a planned page by its role in the wiki structure.
Used by the plan-preview modal to group and lock required pages.
"""
enum LivingWikiPageType {
  REPO_WIDE
  ARCHITECTURE
  TOP_LEVEL_DIR
}

"""
LivingWikiPlanPage describes one page that would be generated by a cold-start
run. required = true marks the three repo-wide pages (api_reference,
system_overview, glossary) which are always generated and cannot be deselected.
"""
type LivingWikiPlanPage {
  id: ID!
  templateId: String!
  title: String!
  pageType: LivingWikiPageType!
  """
  subsystem is the cluster label or package path for architecture/top-level-dir
  pages; null for repo-wide pages.
  """
  subsystem: String
  audience: String!
  required: Boolean!
}

"""
LivingWikiPlan is a deterministic preview of the page set a Living Wiki
cold-start would produce. The planSignature must be echoed back on
enableLivingWikiForRepo whenever selectedPageIds is supplied (including an
empty list); otherwise the mutation rejects with extension code
LIVING_WIKI_PLAN_STALE.
"""
type LivingWikiPlan {
  planSignature: String!
  mode: String!
  modeTooltip: String!
  """
  summary is the backend-rendered planning summary string. The UI computes its
  own display text from totalPages + group counts; this field is available for
  debug surfaces and slog.
  """
  summary: String!
  totalPages: Int!
  preCap: Int!
  """
  capSource is "none", "repo_setting", or "per_run_override".
  """
  capSource: String!
  """
  capValue is the numeric cap used (0 when capSource is "none").
  """
  capValue: Int!
  pages: [LivingWikiPlanPage!]!
  """
  notice is set when the wiki is disabled or kill-switched; the UI renders it
  as a banner rather than displaying the empty page list.
  """
  notice: String
}
